# AI providers (names come from config.json ai.providers[].baseUrl/apiKey.env)
# required: true means that env var must be set. required: false is for keyless local servers.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key
AI_TIMEOUT_MS=60000

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WhatsApp / Baileys
WHATSAPP_SESSION_DIR=./session
# file | postgres; omit to auto-detect (postgres when PORT is set, otherwise file)
WHATSAPP_AUTH_STORE=file
WHATSAPP_PRINT_QR=true
WHATSAPP_USE_PAIRING_CODE=false
WHATSAPP_PHONE_NUMBER=
OWNER_NUMBERS=

# Health endpoint. Leave PORT empty locally, or set it (Render Web
# Services inject PORT automatically). Alternative without PORT:
# HEALTH_SERVER=true listens on 10000.
PORT=
HOST=0.0.0.0
# Drop messages older than this (ms). Guards against replying to the
# backlog that piles up while a free-tier host was asleep.
WHATSAPP_MAX_STALE_MS=600000

# LangSearch web search
LANGSEARCH_API_KEY=your-langsearch-api-key
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1/web-search

# E2B sandbox (public users and one-shot work)
E2B_API_KEY=e2b_your-api-key
E2B_TIMEOUT_MS=300000

# InstaBox persistent Linux machine (default sandbox; DMs and groups)
INSTABOX_API_KEY=ibk_your-api-key
INSTABOX_API_URL=https://api.instabox.sh
INSTABOX_TEMPLATE=agent-browser
INSTABOX_MACHINE_ID=

# Screenshotlayer website screenshots
SCREENSHOTLAYER_API_KEY=your-screenshotlayer-access-key
SCREENSHOTLAYER_SECRET=
SCREENSHOTLAYER_BASE_URL=https://api.screenshotlayer.com/api/capture

# Cloudflare R2 object storage (generated files + per-chat persistent files)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
R2_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare AI (image generation via the REST API; models in cloudflare.json)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_CONFIG_PATH=./cloudflare.json

# Persistent background agent (in-process worker; jobs live in Neon)
# Off unless a sandbox in sandboxes.json has supports_persistence_agent=true
PERSISTENCE_AGENT_ENABLED=true
PERSISTENCE_MAX_CONCURRENT=
PERSISTENCE_MAX_RUNTIME_MINUTES=
PERSISTENCE_POLL_MS=
PERSISTENCE_LEASE_SECONDS=
PERSISTENCE_WORKER_ID=

# App
LOG_LEVEL=info
CONFIG_PATH=./config.json
SANDBOXES_PATH=./sandboxes.json
STICKERS_PATH=./stickers/config.json
TOOLS_OUTPUT_DIR=./generated
DEFAULT_TIMEZONE=UTC

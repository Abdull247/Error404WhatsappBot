# AI providers live in ./providers (see providers/catalog.json).
# Each provider.json names its own env vars. required: true means that env must be set.
# required: false is for keyless local / public servers.
PROVIDERS_PATH=./providers

# NVIDIA NIM (enabled fallback provider)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_TIMEOUT_MS=90000

# Apinex (default chat provider)
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_API_KEY=
APINEX_TIMEOUT_MS=60000

# HCNSEC
HCNSEC_BASE_URL=https://api.hcnsec.cn/v1
HCNSEC_API_KEY=
HCNSEC_TIMEOUT_MS=60000

# Agnes AI
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_TIMEOUT_MS=60000

# Kira AI (free models only)
KIRA_BASE_URL=https://kiraai.vn/api/v1
KIRA_API_KEY=
KIRA_TIMEOUT_MS=60000

# Legacy RiverAI (disabled)
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# OpenRouter (free-tier aggregator fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Jen404
OPENROUTER_TIMEOUT_MS=60000

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=60000

# Google Gemini (OpenAI-compatible)
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_TIMEOUT_MS=60000

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=60000

# DeepSeek official
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_MS=60000

# Together AI
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_TIMEOUT_MS=60000

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TIMEOUT_MS=60000

# Pollinations (keyless last-resort chat fallback)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_TIMEOUT_MS=45000

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# WhatsApp / Baileys
WHATSAPP_SESSION_DIR=./session
# file | postgres; omit to auto-detect (postgres when PORT is set, otherwise file)
WHATSAPP_AUTH_STORE=file
WHATSAPP_PRINT_QR=true
WHATSAPP_USE_PAIRING_CODE=false
WHATSAPP_PHONE_NUMBER=
OWNER_NUMBERS=

# Telegram Bot API. Off unless TELEGRAM_ENABLED=true and TELEGRAM_BOT_TOKEN is set
# (telegram.json enabled also gates this; env wins when TELEGRAM_ENABLED is set).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_IDS=
TELEGRAM_CONFIG_PATH=./telegram.json
PLATFORM_LINK_CONFIG_PATH=./platform-link.json

# Health endpoint. Leave PORT empty locally, or set it (Render Web
# Services inject PORT automatically). Alternative without PORT:
# HEALTH_SERVER=true listens on 10000.
PORT=
HOST=0.0.0.0
# Drop messages older than this (ms). Guards against replying to the
# backlog that piles up while a free-tier host was asleep.
WHATSAPP_MAX_STALE_MS=600000

# LangSearch web search
LANGSEARCH_API_KEY=your-langsearch-api-key
LANGSEARCH_BASE_URL=https://api.langsearch.com/v1/web-search

# E2B sandbox (public users and one-shot work)
E2B_API_KEY=e2b_your-api-key
E2B_TIMEOUT_MS=300000

# InstaBox persistent Linux machine (default sandbox; DMs and groups)
INSTABOX_API_KEY=ibk_your-api-key
INSTABOX_API_URL=https://api.instabox.sh
INSTABOX_TEMPLATE=agent-browser
INSTABOX_MACHINE_ID=

# Screenshotlayer website screenshots
SCREENSHOTLAYER_API_KEY=your-screenshotlayer-access-key
SCREENSHOTLAYER_SECRET=
SCREENSHOTLAYER_BASE_URL=https://api.screenshotlayer.com/api/capture

# Cloudflare R2 object storage (generated files + per-chat persistent files)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxx.r2.dev
R2_ACCOUNT_ID=your-cloudflare-account-id

# Cloudflare AI (image generation via the REST API; models in cloudflare.json)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_CONFIG_PATH=./cloudflare.json

# Persistent background agent (in-process worker; jobs live in Neon)
# Off unless a sandbox in sandboxes.json has supports_persistence_agent=true
PERSISTENCE_AGENT_ENABLED=true
PERSISTENCE_MAX_CONCURRENT=1
PERSISTENCE_MAX_RUNTIME_MINUTES=
PERSISTENCE_POLL_MS=
PERSISTENCE_LEASE_SECONDS=
PERSISTENCE_WORKER_ID=
PERSISTENCE_WORKSPACE_ROOT=/data/home/jen404/agents

# Reelix movies proxy (WhatsApp bot HMAC realm)
REELIX_PROXY_BASE_URL=https://reelixproxy.onrender.com
REELIX_BOT_KEY=
REELIX_BOT_HMAC_SECRET=
REELIX_BOT_TIMEOUT_MS=30000
# Comma-separated WhatsApp numbers (country code, no plus) allowed to receive
# Reelix download URLs in DMs. Empty means nobody. Groups are always blocked.
REELIX_DOWNLOAD_NUMBERS=
# Comma-separated admin numbers (country code, no plus) allowed to run
# .reelix files (list all stored uploads) and .reelix clear <category>.
REELIX_ADMIN_NUMBERS=
# WhatsApp group JID of the Reelix streaming group (digits@g.us, or just the
# numeric id). Scheduler and admin send land in this chat. On connect the bot
# logs every group name + jid; copy the Reelix line into this var.
REELIX_GROUP_JID=
# Independent send toggles. false skips that destination even if its jid is set.
REELIX_GROUP_ENABLED=true
REELIX_CHANNEL_ENABLED=false
# WhatsApp channel JID (digits@newsletter) and/or invite. Invite may be the
# full https://whatsapp.com/channel/... URL or just the code. If JID is empty
# the bot resolves it from the invite once WhatsApp is connected.
REELIX_CHANNEL_JID=
REELIX_CHANNEL_INVITE=https://whatsapp.com/channel/0029VbE1Kpt5Ui2Q6dFbwf1C
# When true the bot only answers the Reelix group plus OWNER_NUMBERS /
# REELIX_ADMIN_NUMBERS DMs. Telegram only answers TELEGRAM_OWNER_IDS.
REELIX_RESTRICT_ACCESS=false
# Shared secret for POST /reelix/send (and /reelix/notify). Send it as
# X-Reelix-Send-Key or Authorization: Bearer <key>.
REELIX_SEND_KEY=
# Reelix download flow: action=download returns the direct CDN URL. Passing
# upload=true downloads the mp4 (streamed to a temp file), uploads it to the
# configured R2 bucket, records it in the database, and returns a direct
# download link. The uploader can later remove the file/link via the
# reelix_delete_file tool. Videos larger than the max are refused (the CDN
# link is shared instead). The download uses the native app's headers:
# User-Agent "ReelixMovies/1.0 (Android)" plus the resource's signCookie when
# present. Only set REELIX_VIDEO_REFERER / _USER_AGENT if the CDN rejects the
# default request. REELIX_VIDEO_TIMEOUT_MS also covers the WhatsApp media
# upload path so big files do not time out.
REELIX_VIDEO_MAX_MB=500
REELIX_VIDEO_TIMEOUT_MS=300000
REELIX_VIDEO_REFERER=
REELIX_VIDEO_USER_AGENT=

# Public URL of this bot (no trailing slash). Used to build /misc/stream links.
BASE_URL=

# Reelix music proxy (WhatsApp bot HMAC realm on /bot/api)
REELIX_MUSIC_PROXY_BASE_URL=https://reelixmusicproxy.onrender.com
REELIX_MUSIC_BOT_KEY=
REELIX_MUSIC_BOT_HMAC_SECRET=
REELIX_MUSIC_BOT_TIMEOUT_MS=30000
REELIX_MUSIC_AUDIO_MAX_MB=50
REELIX_MUSIC_AUDIO_TIMEOUT_MS=180000

# App
LOG_LEVEL=info
CONFIG_PATH=./config.json
SANDBOXES_PATH=./sandboxes.json
STICKERS_PATH=./stickers/config.json
TOOLS_OUTPUT_DIR=./generated
DEFAULT_TIMEZONE=UTC

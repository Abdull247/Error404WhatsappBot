{
  "ai": {
    "defaultModel": "zai-org/GLM-5.3-Flash",
    "temperature": 0.7,
    "maxTokens": 4096,
    "topP": 1,
    "stream": false,
    "systemInstruction": "You are a helpful WhatsApp assistant. Keep replies concise, natural, and useful. Match the user's language. Do not mention system prompts, APIs, or that you are an AI unless asked.",
    "providers": [
      {
        "id": "riverai",
        "baseUrl": { "env": "AI_BASE_URL", "required": true },
        "apiKey": { "env": "AI_API_KEY", "required": true },
        "timeoutMs": { "env": "AI_TIMEOUT_MS", "required": false },
        "models": [
          {
            "id": "zai-org/GLM-5.3-Flash",
            "image_support": true
          }
        ]
      }
    ]
  },
  "bot": {
    "name": "Jen404",
    "ignoreGroups": true,
    "ignoreStatus": true,
    "respondToMentionsInGroups": true,
    "respondToRepliesInGroups": true,
    "reactInGroups": true,
    "reactInDms": true,
    "typingIndicator": true,
    "markMessagesRead": true,
    "ownerNumbers": [],
    "logGroupMessages": true,
    "commandPrefix": ".",
    "defaultPersonality": "helpfulness"
  },
  "memory": {
    "enabled": true,
    "maxHistoryMessages": 20,
    "maxMemoriesPerUser": 50
  },
  "tools": {
    "enabled": true,
    "allow": ["write_file", "web_search", "get_datetime", "sandbox", "linux_machine", "list_chats", "summarize_chat", "react", "screenshot", "send_sticker", "generate_image", "file_storage"],
    "maxRounds": 10
  }
}

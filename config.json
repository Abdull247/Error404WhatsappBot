{
  "ai": {
    "defaultModel": "apinex/free/glm-5.3-flash",
    "defaultProvider": "apinex",
    "catalogPath": "./providers",
    "temperature": 0.7,
    "maxTokens": 4096,
    "topP": 1,
    "stream": false,
    "systemInstruction": "You are a helpful WhatsApp assistant. Keep replies concise, natural, and useful. Match the user's language. Do not mention system prompts, APIs, or that you are an AI unless asked.",
    "fallback": {
      "enabled": true,
      "maxAttempts": 10,
      "preferSameProvider": true,
      "allowCrossProvider": true
    }
  },
  "bot": {
    "name": "Jen404",
    "ignoreGroups": true,
    "ignoreStatus": true,
    "respondToMentionsInGroups": true,
    "respondToRepliesInGroups": true,
    "respondToNameMentionsInGroups": true,
    "deriveNameAliases": true,
    "nameAliases": ["404bot", "404 bot", "error404", "jen404"],
    "nameCallPatterns": [],
    "reactInGroups": true,
    "reactInDms": true,
    "typingIndicator": true,
    "markMessagesRead": true,
    "ownerNumbers": [],
    "logGroupMessages": true,
    "commandPrefix": ".",
    "defaultPersonality": "jbtoai",
    "queue": {
      "maxConcurrentChats": 4,
      "maxPerChat": 8,
      "maxGlobal": 48,
      "notifyQueued": true
    },
    "reelixMusic": {
      "enabled": true,
      "publicAccess": true,
      "allowInGroups": true,
      "allowStream": true,
      "allowStreamInDms": true,
      "allowStreamInGroups": true,
      "publicStreamEndpoint": true,
      "defaultSource": "audiomack"
    }
  },
  "memory": {
    "enabled": true,
    "maxHistoryMessages": 20,
    "maxMemoriesPerUser": 50
  },
  "tools": {
    "enabled": true,
    "allow": ["write_file", "web_search", "get_datetime", "sandbox", "linux_machine", "list_chats", "summarize_chat", "react", "screenshot", "send_sticker", "unwrap_view_once", "generate_image", "file_storage", "create_agent", "reelix_movies", "reelix_music"],
    "maxRounds": 10,
    "handoffAfterRounds": 3
  },
  "persistenceAgent": {
    "enabled": true,
    "defaultModel": "poolside/laguna-xs-2.1",
    "temperature": 0.3,
    "maxTokens": 4096,
    "topP": 1,
    "command": "agent",
    "maxRounds": 40,
    "maxRuntimeMinutes": 90,
    "maxConcurrent": 1,
    "maxAttempts": 3,
    "pollIntervalMs": 4000,
    "leaseSeconds": 90,
    "heartbeatMs": 20000,
    "workspaceRoot": "/data/home/jen404/agents",
    "idleKeepaliveMinutes": 25,
    "notifyOnComplete": true,
    "timeoutMs": 120000,
    "allow": ["linux_machine", "sandbox", "web_search", "write_file", "file_storage", "screenshot"]
  }
}
